# Optional existing local Python environment with piper + onnxruntime.
ROMANA_TTS_PYTHON=/absolute/path/to/existing/venv/bin/python
ROMANA_TTS_MODEL=/absolute/path/to/ro_RO-mihai-medium.onnx
ROMANA_TTS_ORIGIN=http://127.0.0.1:8792
# On a static host, leave empty unless a separately hosted Romanian endpoint exists.
VITE_ROMANA_TTS_ENDPOINT=
