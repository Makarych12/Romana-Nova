  },
  {
    "id": "academy-playback:43",
    "kind": "phonetic-rule:rhythm",
    "text": "Bună ziua!",
    "url": "/audio/a5de4d43c03eee7b92f3d038.mp3"
  },
  {
    "id": "academy-playback:44",
    "kind": "phonetic-mode:syllable",
    "text": "ma",
    "url": "/audio/3c44c3e1b8b7844786724ac7.mp3"
  },
  {
    "id": "academy-playback:45",
    "kind": "phonetic-mode:contrast",
    "text": "sare",
    "url": "/audio/9b2389f06978fe3ef6dd57f8.mp3"
  },
  {
    "id": "academy-playback:46",
    "kind": "phonetic-mode:sentence;phonetic-mode:phonetic-dictation",
    "text": "Beau apă.",
    "url": "/audio/c2e4def196bb352e438901d3.mp3"
  },
  {
    "id": "academy-playback:47",
    "kind": "listening:Диктант",
    "text": "Bună! Eu sunt Ana. Tu cum te numești?",
    "url": "/audio/ba011d3576639f8530de10dd.mp3"
  },
  {
    "id": "academy-playback:48",
    "kind": "listening:Значение",
    "text": "Mă numesc Andrei. Îmi pare bine!",
    "url": "/audio/ab0eb3fc0bec145c5b3ed865.mp3"
  },
  {
    "id": "academy-playback:49",
    "kind": "listening:Пропуск",
    "text": "Și mie. De unde ești?",
    "url": "/audio/5d48ae476e03e99967bac660.mp3"
  },
  {
    "id": "academy-playback:50",
    "kind": "listening:Аудио → текст",
    "text": "Sunt din Rusia, dar acum locuiesc în București.",
    "url": "/audio/05ebabfe4c58640ff22b590b.mp3"
  },
  {
    "id": "academy-playback:51",
    "kind": "listening:Порядок реплик",
    "text": "Bună! Eu sunt Ana. Tu cum te numești? Mă numesc Andrei. Îmi pare bine! Și mie. De unde ești?",
    "url": "/audio/b668df125ef9e8c10523b36d.mp3"
  },
  {
    "id": "academy-playback:52",
    "kind": "listening:Вопрос по услышанному",
    "text": "Cafeaua costă doisprezece lei.",
    "url": "/audio/17e421807539a240ab98981e.mp3"
  },
  {
    "id": "academy-playback:53",
    "kind": "listening:monologue",
    "text": "Mă numesc Pavel. Luna trecută m-am mutat din Brașov la București pentru un loc de muncă nou. La început am stat la un hotel. Acum închiriez un apartament mic lângă gară. Merg la serviciu cu autobuzul, iar seara învăț limba română.",
    "url": "/audio/51719895cf9f18bf92ae9d32.mp3"
  },
  {
    "id": "academy-playback:54",
    "kind": "grammar:Prezent",
    "text": "sunt",
    "url": "/audio/ed68511884c42fd03769885f.mp3"
  },
  {
    "id": "academy-playback:55",
    "kind": "grammar:Perfect compus",
    "text": "am fost",
    "url": "/audio/6c66abf469679d804c34491a.mp3"
  },
  {
    "id": "academy-playback:56",
    "kind": "grammar:Imperfect",
    "text": "eram",
    "url": "/audio/322a47fa1a25fadbae7486ac.mp3"
  },
  {
    "id": "academy-playback:57",
    "kind": "grammar:Viitor",
    "text": "voi fi",
    "url": "/audio/e5ec8a813bebc7547615b759.mp3"
  },
  {
    "id": "academy-playback:58",
    "kind": "grammar:Conjunctiv prezent",
    "text": "să fiu",
    "url": "/audio/f6d3dbc4996759da45ccb2d7.mp3"
  },
  {
    "id": "academy-playback:59",
    "kind": "grammar:Condițional prezent",
    "text": "aș fi",
    "url": "/audio/706b2531859a668c99629c5e.mp3"
  },
