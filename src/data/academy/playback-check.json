  {
    "id": "academy-playback:71",
    "kind": "railway:academy:rail:unit:11",
    "text": "șubler",
    "url": "/audio/e50717196017644089e56a95.mp3"
  },
  {
    "id": "academy-playback:72",
    "kind": "dialogue-family:cafe",
    "text": "Aș dori o cafea, vă rog.",
    "url": "/audio/edd7cf6d772f725378ec543d.mp3"
  },
  {
    "id": "academy-playback:73",
    "kind": "dialogue-family:bakery",
    "text": "Aș dori o pâine integrală.",
    "url": "/audio/d08987f34429b850f98587b1.mp3"
  },
  {
    "id": "academy-playback:74",
    "kind": "dialogue-family:restaurant",
    "text": "Da, aș dori o supă de legume.",
    "url": "/audio/1670ba9533a1bc96b2f046d6.mp3"
  },
  {
    "id": "academy-playback:75",
    "kind": "dialogue-family:grocery",
    "text": "Caut un kilogram de mere.",
    "url": "/audio/9f085dc8cc3e0bff8415e455.mp3"
  },
  {
    "id": "academy-playback:76",
    "kind": "dialogue-family:clothes",
    "text": "Aș vrea să probez această cămașă.",
    "url": "/audio/f19ddbb13a331b0b1c90aa07.mp3"
  },
  {
    "id": "academy-playback:77",
    "kind": "dialogue-family:shoes",
    "text": "Aș dori să probez acești pantofi, mărimea patruzeci.",
    "url": "/audio/b71efee38258975df3716cc5.mp3"
  },
  {
    "id": "academy-playback:78",
    "kind": "dialogue-family:hotel-booking",
    "text": "Aș dori o cameră single.",
    "url": "/audio/ec51a5555bf98b9fedbc96ea.mp3"
  },
  {
    "id": "academy-playback:79",
    "kind": "dialogue-family:hotel-issue",
    "text": "În camera mea nu funcționează aerul condiționat.",
    "url": "/audio/0af96ea184975e0e2bc19fec.mp3"
  },
  {
    "id": "academy-playback:80",
    "kind": "dialogue-family:rental",
    "text": "Aș vrea să știu dacă utilitățile sunt incluse.",
    "url": "/audio/4fb82da25006ed5cc3bcc788.mp3"
  },
  {
    "id": "academy-playback:81",
    "kind": "dialogue-family:home-repair",
    "text": "Am observat că robinetul picură.",
    "url": "/audio/1ebf08dafa58ea3a4765bf22.mp3"
  },
  {
    "id": "academy-playback:82",
    "kind": "dialogue-family:train-ticket",
    "text": "Aș dori un bilet până la Brașov.",
    "url": "/audio/985b6b15f8b30f6f0b7cdbec.mp3"
  },
  {
    "id": "academy-playback:83",
    "kind": "dialogue-family:bus",
    "text": "Cum ajung la gară?",
    "url": "/audio/962856311a33fb78f8f9428d.mp3"
  },
  {
    "id": "academy-playback:84",
    "kind": "dialogue-family:taxi",
    "text": "La gară, vă rog.",
    "url": "/audio/0952694e48d1bb89bb7bb484.mp3"
  },
  {
    "id": "academy-playback:85",
    "kind": "dialogue-family:doctor",
    "text": "De ieri mă doare gâtul.",
    "url": "/audio/da6755fd25da915d3e5cae9d.mp3"
  },
  {
    "id": "academy-playback:86",
    "kind": "dialogue-family:pharmacy",
    "text": "Aveți un termometru?",
    "url": "/audio/ae5ac94c22b5e51909d70f0f.mp3"
  },
  {
    "id": "academy-playback:87",
    "kind": "dialogue-family:documents",
    "text": "Doresc să depun cererea de înscriere.",
    "url": "/audio/9680efddd1d909cafd4b7477.mp3"
  },
  {
    "id": "academy-playback:88",
    "kind": "dialogue-family:bank",
    "text": "Aș dori informații despre deschiderea unui cont.",
    "url": "/audio/d5113cadd52cfca3d014e561.mp3"
  },
  {
    "id": "academy-playback:89",
    "kind": "dialogue-family:phone",
    "text": "Sun în legătură cu programarea de mâine.",
    "url": "/audio/bd617d3f3deeeee3a9173f74.mp3"
  },
  {
    "id": "academy-playback:90",
    "kind": "dialogue-family:interview",
    "text": "Am lucrat trei ani în logistică.",
    "url": "/audio/5c7b4d063f9d1f2ee96ee6ec.mp3"
  },
  {
    "id": "academy-playback:91",
    "kind": "dialogue-family:work-task",
    "text": "Aș vrea să discutăm despre raportul lunar.",
    "url": "/audio/60baaa9874a554957873b961.mp3"
  },
  {
    "id": "academy-playback:92",
    "kind": "dialogue-family:meeting",
    "text": "Sunt disponibil luni dimineață.",
    "url": "/audio/348f7c03150c2789d8c38868.mp3"
  },
  {
    "id": "academy-playback:93",
    "kind": "dialogue-family:course",
    "text": "Mă interesează un curs de limba română.",
    "url": "/audio/b52db6b7f213c37410818060.mp3"
  },
  {
    "id": "academy-playback:94",
    "kind": "dialogue-family:library",
    "text": "Caut o carte despre istoria României.",
    "url": "/audio/13745ccb42d9a6edc01b6788.mp3"
  },
  {
    "id": "academy-playback:95",
    "kind": "dialogue-family:tourism",
    "text": "Aș vrea să vizitez muzeul de artă.",
    "url": "/audio/3e61cf6c4ac7d6780fafc0e5.mp3"
  },
  {
    "id": "academy-playback:96",
    "kind": "dialogue-family:delivery",
    "text": "Aștept un colet cu cărți.",
    "url": "/audio/c498a5a7dd75bfecd6e8a1c3.mp3"
  },
  {
    "id": "academy-playback:97",
    "kind": "dialogue-family:return",
    "text": "Doresc să returnez produsul deoarece nu pornește.",
    "url": "/audio/c1c88e7bb77ac6744a651058.mp3"
  },
  {
    "id": "academy-playback:98",
    "kind": "dialogue-family:depot",
    "text": "Am consemnat o pierdere de aer în raport.",
    "url": "/audio/e5870f45b39238433e77e933.mp3"
  },
  {
    "id": "academy-playback:99",
    "kind": "dialogue-family:maintenance",
