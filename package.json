{
  "name": "romana-nova",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "preview": "vite preview --host 0.0.0.0",
    "prepare:content": "node --experimental-strip-types scripts/prepare-content.mjs && node --experimental-strip-types scripts/write-audio-provenance.mjs && node --experimental-strip-types scripts/build-audio-index.mjs && node --experimental-strip-types scripts/build-academy-checks.mjs",
    "prebuild": "npm run prepare:content",
    "predev": "npm run prepare:content",
    "audit:content": "node --experimental-strip-types scripts/audit-content.mjs",
    "audit:audio": "node --experimental-strip-types scripts/audit-media.mjs --decode"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.24",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.9.3",
    "vite": "^7.1.10",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
